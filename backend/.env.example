# Copie este arquivo para ".env" (ou apenas exporte estas variáveis no seu
# ambiente) e ajuste os valores. Em produção, defina pelo menos DATABASE_URL,
# JWT_SECRET e NODE_ENV.

# String de conexão do Postgres. Copie da Neon (ou Supabase/Railway) --
# formato: postgres://usuario:senha@host:5432/nomedobanco
# Sem esta variável, o servidor tenta um Postgres local em
# postgres://postgres:postgres@localhost:5432/seulugar (só funciona se você
# tiver um Postgres instalado na própria máquina).
DATABASE_URL=

# Chave usada para assinar os tokens de login. Se não for definida, o servidor
# gera uma automaticamente na primeira execução e salva em backend/.jwt-secret
# (não versionado no git). Em produção defina esta variável explicitamente
# (senão, toda reinicialização do servidor derruba a sessão de todo mundo).
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Por quantos dias o login fica válido antes de pedir senha de novo.
JWT_EXPIRES_DAYS=30

# Porta em que o servidor roda. A maioria das hospedagens (Render, Railway)
# define esta variável sozinha -- não precisa mexer.
PORT=4000

# Endereço do frontend, liberado para falar com a API (CORS + cookies). Só é
# usado quando o frontend roda separado do backend (frontend/serve.js, modo
# de desenvolvimento). Em produção, o backend serve o frontend junto, então
# esta variável não tem efeito.
FRONTEND_ORIGIN=http://localhost:5173

# "development" ou "production". Em produção, os cookies de login exigem HTTPS.
NODE_ENV=development
