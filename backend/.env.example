# Copie este arquivo para ".env" (ou apenas exporte estas variáveis no seu
# ambiente) e ajuste os valores. Nenhuma delas é obrigatória para rodar em
# desenvolvimento -- o servidor cria valores padrão sozinho na primeira vez
# que roda (veja src/config.js). Em produção, defina pelo menos JWT_SECRET
# e FRONTEND_ORIGIN.

# Onde fica o arquivo do banco de dados (SQLite). Padrão: backend/data/seulugar.db
DATABASE_FILE=./data/seulugar.db

# Chave usada para assinar os tokens de login. Se não for definida, o servidor
# gera uma automaticamente na primeira execução e salva em backend/.jwt-secret
# (não versionado no git). Em produção com mais de um servidor rodando ao
# mesmo tempo, defina esta variável explicitamente com o mesmo valor em todos.
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Por quantos dias o login fica válido antes de pedir senha de novo.
JWT_EXPIRES_DAYS=30

# Porta em que a API roda.
PORT=4000

# Endereço do frontend, liberado para falar com a API (CORS + cookies).
FRONTEND_ORIGIN=http://localhost:5173

# "development" ou "production". Em produção, os cookies de login exigem HTTPS.
NODE_ENV=development
